# Copied to .env on your machine and on the server. The values here are for
# development; the README's "Deploy" says what the server changes.

# Everywhere.
NODE_ENV=development
COMPOSE_PROJECT_NAME=unagistart
PORT=3000
CORS_ORIGINS=http://localhost:4321
FRONTEND_URL=http://localhost:4321
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
JWT_SECRET=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=

# Only on the server: empty on your machine, so development's errors don't
# reach Sentry and nothing backs it up.
SENTRY_DSN=
COMPOSE_PROFILES=
BACKUP_AGE_RECIPIENT=

# On the server, and on your machine for the restore drill.
BACKUP_B2_KEY_ID=
BACKUP_B2_APPLICATION_KEY=

# Only on your machine: the server `make deploy`, `make api/ssh` and
# `make api/pull-db` reach.
SERVER_SSH=
SERVER_PATH=
